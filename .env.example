# OpenAI — classifier, composer, grounding verifier, embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/triage

# Chroma (own service on Railway; local: `chroma run --path .data/chroma`)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=kb_chunks

# Admin console basic auth
ADMIN_USER=admin
ADMIN_PASS=change-me

# Routing thresholds (tuned against the eval set)
SCORE_FLOOR=0.35
SCORE_AUTO=0.55

# PostHog (optional)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

PORT=3000
